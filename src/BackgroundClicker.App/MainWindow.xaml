<ui:FluentWindow x:Class="BackgroundClicker.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:views="clr-namespace:BackgroundClicker.App.Views"
                  Title="BackgroundClicker"
                  Height="720"
                  Width="960"
                  MinHeight="600"
                  MinWidth="780"
                  WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="BackgroundClicker"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Header>
                <TextBlock Text="BackgroundClicker"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Fluent Sidebar Navigation -->
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           OpenPaneLength="180"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Target"
                                       TargetPageType="{x:Type views:TargetPage}"
                                       Icon="{ui:SymbolIcon Target24}" />
                <ui:NavigationViewItem Content="Click Sequence"
                                       TargetPageType="{x:Type views:SimplePage}"
                                       Icon="{ui:SymbolIcon Cursor24}" />
                <ui:NavigationViewItem Content="Macro"
                                       TargetPageType="{x:Type views:MacroPage}"
                                       Icon="{ui:SymbolIcon Play24}" />
                <ui:NavigationViewItem Content="Profiles"
                                       TargetPageType="{x:Type views:ProfilesPage}"
                                       Icon="{ui:SymbolIcon DocumentFolder24}" />
                <ui:NavigationViewItem Content="Diagnostics"
                                       TargetPageType="{x:Type views:DiagnosticsPage}"
                                       Icon="{ui:SymbolIcon Bug24}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="ThemeToggleItem"
                                       Content="Toggle Theme"
                                       Icon="{ui:SymbolIcon DarkTheme24}"
                                       Click="OnToggleThemeClick" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Persistent Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Target status -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusTargetText}"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Center: Runner status -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusRunnerText}"
                           Foreground="{Binding StatusRunnerColor}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <!-- Right: Hotkeys info -->
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusHotkeysText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
