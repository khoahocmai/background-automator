<Page x:Class="BackgroundClicker.App.Views.SimplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:BackgroundClicker.App.Converters"
      Title="SimplePage">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section 1: Target Summary & Point Setup -->
        <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding TargetSummaryText}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Margin="0,0,0,10"
                           TextTrimming="CharacterEllipsis" />

                <!-- Point builder row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                    <ui:NumberBox Grid.Column="1" Value="{Binding CustomX, Mode=TwoWay}" Minimum="-32768" Maximum="32767" Margin="0,0,12,0" />

                    <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                    <ui:NumberBox Grid.Column="3" Value="{Binding CustomY, Mode=TwoWay}" Minimum="-32768" Maximum="32767" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <RadioButton Content="Single Click" IsChecked="{Binding IsSingleClick, Mode=TwoWay}" Margin="0,0,12,0" />
                        <RadioButton Content="Double Click" IsChecked="{Binding IsDoubleClick, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="+ Add Target Point"
                                   Appearance="Secondary"
                                   Command="{Binding AddTargetPointCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="+ Add Custom Point"
                                   Appearance="Primary"
                                   Command="{Binding AddCustomPointCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Section 2: Ordered Click Steps (Clean Card/List presentation) -->
        <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Click Sequence"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1"
                               Content="Clear All"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding ClearAllPointsCommand}" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Points}"
                         SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Index Badge -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="12"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Index}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Step Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActionDescription}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding HwndFormatted, StringFormat='HWND: {0}'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontFamily="Consolas" />
                                    </StackPanel>

                                    <!-- Coordinates -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClientX, StringFormat='Client X: {0}'}" FontFamily="Consolas" FontSize="12" />
                                        <TextBlock Text="{Binding ClientY, StringFormat='Client Y: {0}'}" FontFamily="Consolas" FontSize="12" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Icon="{ui:SymbolIcon ArrowUp20}"
                                                   ToolTip="Move Up"
                                                   Padding="6,4"
                                                   Margin="0,0,4,0"
                                                   Command="{Binding DataContext.MovePointUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon ArrowDown20}"
                                                   ToolTip="Move Down"
                                                   Padding="6,4"
                                                   Margin="0,0,4,0"
                                                   Command="{Binding DataContext.MovePointDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon Dismiss20}"
                                                   ToolTip="Remove"
                                                   Appearance="Danger"
                                                   Padding="6,4"
                                                   Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ui:Card>

        <!-- Section 3: Execution Settings & Controls -->
        <ui:Card Grid.Row="2" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Settings -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                    <TextBlock Text="Interval:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                    <ui:NumberBox Value="{Binding IntervalMilliseconds, Mode=TwoWay}" Minimum="10" Maximum="60000" Width="90" Margin="0,0,4,0" />
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,24,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="Repeat:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium" />
                    <RadioButton Content="Until stopped" IsChecked="{Binding IsUntilStopped, Mode=TwoWay}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <RadioButton Content="Count:" IsChecked="{Binding IsCount, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ui:NumberBox Value="{Binding RepeatCount, Mode=TwoWay}" Minimum="1" Maximum="1000000" Width="90" IsEnabled="{Binding IsCount}" />
                </StackPanel>

                <!-- Row 1: Start/Stop and Status -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="▶ Start (F6)"
                               Appearance="Success"
                               Command="{Binding StartRunnerCommand}"
                               IsEnabled="{Binding CanStart}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Padding="16,8"
                               Margin="0,0,10,0" />
                    <ui:Button Content="⏹ Stop (F7)"
                               Appearance="Danger"
                               Command="{Binding StopRunnerCommand}"
                               IsEnabled="{Binding CanStop}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Padding="16,8"
                               Margin="0,0,16,0" />
                    <TextBlock Text="{Binding RunnerStatusText}"
                               Foreground="{Binding RunnerStatusColor}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
