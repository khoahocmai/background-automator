<Page x:Class="BackgroundAutomator.App.Views.TargetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:BackgroundAutomator.App.Converters"
      Title="TargetPage">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- UIPI Warning Banner -->
            <Border Background="#FFF8F8"
                    BorderBrush="#E81123"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasUipiMismatch, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ UIPI Privilege Mismatch" FontWeight="Bold" Foreground="#E81123" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding ElevationText}" Foreground="#333333" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="🛡️ Restart as Administrator"
                               Appearance="Danger"
                               Command="{Binding RestartAsAdministratorCommand}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- Card 1: Select Target -->
            <ui:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Select Target"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableWindows}"
                                  SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayText"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />
                        <ui:Button Grid.Column="1"
                                   Content="Refresh"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Command="{Binding RefreshWindowsCommand}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Button x:Name="CrosshairButton"
                            Content="◎ Drag crosshair onto a window / control"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Height="38"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"
                            PreviewMouseLeftButtonDown="OnCrosshairMouseDown"
                            PreviewMouseMove="OnCrosshairMouseMove"
                            PreviewMouseLeftButtonUp="OnCrosshairMouseUp"
                            LostMouseCapture="OnCrosshairLostMouseCapture" />
                </StackPanel>
            </ui:Card>

            <!-- Card 2: Current Target -->
            <ui:Card Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Current Target"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Refresh Coordinates"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Command="{Binding RefreshCoordinatesCommand}"
                                       IsEnabled="{Binding IsTargetActive}"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="Clear Target"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding ClearTargetCommand}"
                                       IsEnabled="{Binding IsTargetActive}" />
                        </StackPanel>
                    </Grid>

                    <!-- Primary Info Grid -->
                    <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Application:" FontWeight="SemiBold" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProcessName}" Margin="0,4" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Window Title:" FontWeight="SemiBold" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding WindowTitle}" Margin="0,4" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Status:" FontWeight="SemiBold" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetStatus}" Foreground="{Binding TargetStatusColor}" FontWeight="Medium" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Client X / Y:" FontWeight="SemiBold" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ClientCoordsText}" FontFamily="Consolas" Margin="0,4" />
                        </Grid>
                    </Border>

                    <!-- Collapsible Advanced Details -->
                    <ui:CardExpander Header="Advanced details" IsExpanded="False">
                        <Grid Margin="4,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PID:" FontWeight="Medium" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PidText}" FontFamily="Consolas" Margin="0,4" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Thread ID:" FontWeight="Medium" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ThreadIdText}" FontFamily="Consolas" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Root HWND:" FontWeight="Medium" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RootHwndText}" FontFamily="Consolas" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Target HWND:" FontWeight="Medium" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TargetHwndText}" FontFamily="Consolas" Margin="0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Parent HWND:" FontWeight="Medium" Margin="0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ParentHwndText}" FontFamily="Consolas" Margin="0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Window Class:" FontWeight="Medium" Margin="0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding WindowClassText}" FontFamily="Consolas" Margin="0,4" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Screen X / Y:" FontWeight="Medium" Margin="0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ScreenCoordsText}" FontFamily="Consolas" Margin="0,4" />

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Client X / Y:" FontWeight="Medium" Margin="0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding ClientCoordsText}" FontFamily="Consolas" Margin="0,4" />
                        </Grid>
                    </ui:CardExpander>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
