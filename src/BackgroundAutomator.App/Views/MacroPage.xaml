<Page x:Class="BackgroundAutomator.App.Views.MacroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:BackgroundAutomator.App.Converters"
      Title="MacroPage">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section 1: Configure & Add Macro Action -->
        <ui:CardExpander Grid.Row="0" Header="{Binding BuilderHeader}" IsExpanded="True" Margin="0,0,0,12">
            <TabControl SelectedIndex="{Binding SelectedActionCategoryIndex, Mode=TwoWay}" Margin="0,8,0,0">
                <!-- Mouse Tab -->
                <TabItem Header="Mouse">
                    <StackPanel Orientation="Horizontal" Margin="8,12,8,8" VerticalAlignment="Center">
                        <TextBlock Text="Client X:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding ActionX, Mode=TwoWay}" Minimum="0" Maximum="9999" Width="85" Margin="0,0,12,0" />

                        <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding ActionY, Mode=TwoWay}" Minimum="0" Maximum="9999" Width="85" Margin="0,0,14,0" />

                        <ui:Button Content="🎯 From Target"
                                   Command="{Binding UseTargetPointCommand}"
                                   Margin="0,0,14,0" />

                        <ui:Button Content="+ Click"
                                   Appearance="Primary"
                                   Command="{Binding AddClickActionCommand}"
                                   Visibility="{Binding IsNotEditingAction, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,8,0" />

                        <ui:Button Content="+ Double Click"
                                   Appearance="Primary"
                                   Command="{Binding AddDoubleClickActionCommand}"
                                   Visibility="{Binding IsNotEditingAction, Converter={StaticResource BoolToVis}}" />

                        <ui:Button Content="Save Changes"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding SaveActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,8,0" />

                        <ui:Button Content="Cancel"
                                   Appearance="Secondary"
                                   Command="{Binding CancelActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem>

                <!-- Keyboard Tab -->
                <TabItem Header="Keyboard">
                    <StackPanel Orientation="Horizontal" Margin="8,12,8,8" VerticalAlignment="Center">
                        <TextBlock Text="Key:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                        <ComboBox ItemsSource="{Binding AvailableKeys}"
                                  SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                                  Width="140"
                                  Margin="0,0,16,0" />

                        <ui:Button Content="+ Press Key"
                                   Appearance="Primary"
                                   Command="{Binding AddPressKeyActionCommand}"
                                   Visibility="{Binding IsNotEditingAction, Converter={StaticResource BoolToVis}}" />

                        <ui:Button Content="Save Changes"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding SaveActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,8,0" />

                        <ui:Button Content="Cancel"
                                   Appearance="Secondary"
                                   Command="{Binding CancelActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem>

                <!-- Timing Tab -->
                <TabItem Header="Timing">
                    <StackPanel Orientation="Horizontal" Margin="8,12,8,8" VerticalAlignment="Center">
                        <TextBlock Text="Delay:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding DelayMilliseconds, Mode=TwoWay}" Minimum="0" Maximum="60000" Width="100" Margin="0,0,6,0" />
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ui:Button Content="+ Add Delay"
                                   Appearance="Primary"
                                   Command="{Binding AddDelayActionCommand}"
                                   Visibility="{Binding IsNotEditingAction, Converter={StaticResource BoolToVis}}" />

                        <ui:Button Content="Save Changes"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding SaveActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,8,0" />

                        <ui:Button Content="Cancel"
                                   Appearance="Secondary"
                                   Command="{Binding CancelActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem>

                <!-- Wait for Color Tab -->
                <TabItem Header="Wait for Color">
                    <StackPanel Orientation="Horizontal" Margin="8,12,8,8" VerticalAlignment="Center">
                        <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding ActionX, Mode=TwoWay}" Minimum="0" Maximum="9999" Width="75" Margin="0,0,10,0" />

                        <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding ActionY, Mode=TwoWay}" Minimum="0" Maximum="9999" Width="75" Margin="0,0,10,0" />

                        <TextBlock Text="Hex Color:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:TextBox Text="{Binding WaitColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,10,0" />

                        <TextBlock Text="Tol:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding WaitColorTol, Mode=TwoWay}" Minimum="0" Maximum="255" Width="65" Margin="0,0,10,0" />

                        <TextBlock Text="Timeout:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding WaitColorTimeoutMs, Mode=TwoWay}" Minimum="100" Maximum="60000" Width="85" Margin="0,0,4,0" />
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ui:Button Content="+ Add WaitColor"
                                   Appearance="Primary"
                                   Command="{Binding AddWaitColorActionCommand}"
                                   Visibility="{Binding IsNotEditingAction, Converter={StaticResource BoolToVis}}" />

                        <ui:Button Content="Save Changes"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding SaveActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,8,0" />

                        <ui:Button Content="Cancel"
                                   Appearance="Secondary"
                                   Command="{Binding CancelActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem>

                <!-- Wait for Text Tab -->
                <TabItem Header="Wait for Text">
                    <StackPanel Orientation="Horizontal" Margin="8,12,8,8" VerticalAlignment="Center">
                        <TextBlock Text="Expected text:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:TextBox Text="{Binding WaitForTextExpected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="190" Margin="0,0,10,0" />

                        <TextBlock Text="Match:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ComboBox ItemsSource="{Binding AvailableMatchModes}"
                                  SelectedItem="{Binding WaitForTextMatchMode, Mode=TwoWay}"
                                  Width="105"
                                  Margin="0,0,10,0" />

                        <TextBlock Text="Poll:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding WaitForTextPollIntervalMs, Mode=TwoWay}" Minimum="50" Maximum="10000" Width="75" Margin="0,0,4,0" />
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Timeout:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <ui:NumberBox Value="{Binding WaitForTextTimeoutMs, Mode=TwoWay}" Minimum="100" Maximum="300000" Width="85" Margin="0,0,4,0" />
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ui:Button Content="+ Add WaitText"
                                   Appearance="Primary"
                                   Command="{Binding AddWaitForTextActionCommand}"
                                   Visibility="{Binding IsNotEditingAction, Converter={StaticResource BoolToVis}}" />

                        <ui:Button Content="Save Changes"
                                   Appearance="Primary"
                                   FontWeight="SemiBold"
                                   Command="{Binding SaveActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,8,0" />

                        <ui:Button Content="Cancel"
                                   Appearance="Secondary"
                                   Command="{Binding CancelActionEditCommand}"
                                   Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem>

                <!-- Safe Auto Confirm Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Safe Auto Confirm" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Orientation="Vertical" Margin="4,8,4,8">
                        <!-- Row 1: Rule & Target Groups -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="*" MinWidth="240" />
                            </Grid.ColumnDefinitions>

                            <!-- Rule Group -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Rule" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Rule name:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                        <ui:TextBox Grid.Column="1" Text="{Binding AutoConfirmRuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Stretch" MinWidth="180" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Target Group -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="8,0,0,0">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Target" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Process:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                        <ui:TextBox Grid.Column="1" Text="{Binding AutoConfirmProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Stretch" MinWidth="160" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 2: Detection Group -->
                        <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Detection" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Prompt:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                    <ui:TextBox Text="{Binding AutoConfirmPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="220" Margin="0,0,20,0" />

                                    <TextBlock Text="Selected option:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                    <ui:TextBox Text="{Binding AutoConfirmSelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="200" Margin="0,0,10,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Row 3: Approval Group (Multi-Rule Rule Set) -->
                        <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Approval Rule Set (Exact Match Only)" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="1" Content="Clear Rules" Padding="6,2" FontSize="11"
                                               Command="{Binding ClearApprovalRulesCommand}" />
                                </Grid>

                                <!-- Add Rule Row -->
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="Rule name:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                                    <ui:TextBox Text="{Binding NewRuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="140" Margin="0,0,10,0" PlaceholderText="e.g. Test Suite" />

                                    <TextBlock Text="Command:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                                    <ui:TextBox Text="{Binding NewRuleCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="280" Margin="0,0,10,0" PlaceholderText="e.g. dotnet test BackgroundAutomator.sln" />

                                    <ui:Button Content="+ Add Rule to Set" Appearance="Primary"
                                               Command="{Binding AddApprovalRuleCommand}" Margin="0,0,10,0" />
                                </WrapPanel>

                                <!-- Rules List -->
                                <ItemsControl ItemsSource="{Binding AutoConfirmRules}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Enabled / Disabled" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CommandText}" FontFamily="Consolas"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="3" Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                                            CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Exact" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Danger" Padding="4,2"
                                                               Command="{Binding DataContext.DeleteApprovalRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}" ToolTip="Remove rule" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Quick fallback input if no rules in list -->
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="Quick / Single command:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBox Text="{Binding AutoConfirmAllowedCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="320" Margin="0,0,12,0" PlaceholderText="Used if no rules added to list above" />
                                    <TextBlock Text="(Used when rules list above is empty)" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Row 4: Execution Group -->
                        <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Execution" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                    <ComboBox ItemsSource="{Binding AvailableExecutionModes}"
                                              SelectedItem="{Binding AutoConfirmExecutionMode, Mode=TwoWay}"
                                              Width="140"
                                              Margin="0,0,16,0" />

                                    <TextBlock Text="Wait:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                    <ComboBox ItemsSource="{Binding AvailableWaitModes}"
                                              SelectedItem="{Binding AutoConfirmWaitMode, Mode=TwoWay}"
                                              Width="130"
                                              Margin="0,0,16,0" />

                                    <TextBlock Text="Focus:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                    <ComboBox ItemsSource="{Binding AvailableFocusBehaviors}"
                                              SelectedItem="{Binding AutoConfirmFocusBehavior, Mode=TwoWay}"
                                              Width="140"
                                              Margin="0,0,16,0" />

                                    <TextBlock Text="Poll interval:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                    <ui:NumberBox Value="{Binding AutoConfirmPollIntervalMs, Mode=TwoWay}" Minimum="50" Maximum="10000" Width="85" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding AutoConfirmPollIntervalDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

                                    <TextBlock Text="Timeout:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                                    <ui:NumberBox Value="{Binding AutoConfirmTimeoutMs, Mode=TwoWay}" Minimum="100" Maximum="300000" Width="95" Margin="0,0,4,0"
                                                  IsEnabled="{Binding IsAutoConfirmTimeoutEnabled}" />
                                    <TextBlock Text="{Binding AutoConfirmTimeoutDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,20,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

                                    <ui:Button Content="+ Add AutoConfirm Action"
                                               Appearance="Primary"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding IsNotEditingAction, Converter={StaticResource BoolToVis}}"
                                               Command="{Binding AddSafeAutoConfirmActionCommand}" />
                                    <ui:Button Content="Save Changes"
                                               Appearance="Primary"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}"
                                               Command="{Binding SaveActionEditCommand}"
                                               Margin="0,0,8,0" />
                                    <ui:Button Content="Cancel"
                                               Visibility="{Binding IsEditingAction, Converter={StaticResource BoolToVis}}"
                                               Command="{Binding CancelActionEditCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </ui:CardExpander>

        <!-- Section 2: Macro Action Sequence -->
        <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Macro Action Sequence"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentProfileDisplay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="Clear All"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding ClearAllActionsCommand}" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Actions}"
                         SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                         MouseDoubleClick="OnActionsListMouseDoubleClick"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Index Badge -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="12"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Index}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Action Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center" />

                                    <!-- Details -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Details}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Status Badge -->
                                    <Border Grid.Column="3"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Margin="4,0,8,0"
                                            ToolTip="{Binding Status}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11" />
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Icon="{ui:SymbolIcon Edit20}"
                                                   ToolTip="Edit Action"
                                                   Padding="6,4"
                                                   Margin="0,0,4,0"
                                                   Command="{Binding DataContext.EditActionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon ArrowUp20}"
                                                   ToolTip="Move Up"
                                                   Padding="6,4"
                                                   Margin="0,0,4,0"
                                                   Command="{Binding DataContext.MoveActionUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon ArrowDown20}"
                                                   ToolTip="Move Down"
                                                   Padding="6,4"
                                                   Margin="0,0,4,0"
                                                   Command="{Binding DataContext.MoveActionDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon Dismiss20}"
                                                   ToolTip="Delete"
                                                   Appearance="Danger"
                                                   Padding="6,4"
                                                   Command="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ui:Card>

        <!-- Section 3: Execution Controls -->
        <ui:Card Grid.Row="2" Padding="14">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Repeat:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AvailableRepeatModes}"
                          SelectedItem="{Binding RepeatMode, Mode=TwoWay}"
                          Width="130" Margin="0,0,12,0" />

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsRepeatCountVisible, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Count:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                    <ui:NumberBox Value="{Binding RepeatCount, Mode=TwoWay}" Minimum="1" Maximum="10000" Width="80" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsCycleDelayVisible, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Cycle delay:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                    <ui:NumberBox Value="{Binding CycleDelayMilliseconds, Mode=TwoWay}" Minimum="0" Maximum="60000" Width="80" Margin="0,0,4,0" />
                    <TextBlock Text="ms" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ui:Button Content="▶ Run Macro"
                           Appearance="Success"
                           Command="{Binding RunMacroCommand}"
                           IsEnabled="{Binding CanRun}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Padding="18,8"
                           Margin="0,0,10,0" />
                <ui:Button Content="⏹ Stop"
                           Appearance="Danger"
                           Command="{Binding StopMacroCommand}"
                           IsEnabled="{Binding CanStop}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Padding="18,8"
                           Margin="0,0,16,0" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{Binding StatusColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </WrapPanel>
        </ui:Card>
    </Grid>
</Page>
